    "@storybook/addon-docs": "^10.6.3",
    "@storybook/vue3-vite": "^10.6.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.13.0",
    "sass-embedded": "^1.106.1",
    "steiger": "^0.8.0",
    "storybook": "^10.6.3",
    "stylelint": "^17.16.0",
